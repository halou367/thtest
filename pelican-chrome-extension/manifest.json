{
  "manifest_version": 3,
  "name": "鹈鹕实验室 · 剪贴板与页面模型鉴定助手",
  "short_name": "鹈鹕鉴定",
  "version": "1.5.1",
  "description": "极简悬浮鉴定：只显示当前页最近 2 个 SVG/HTML 样本（换页即清空），预览 + 模型 + 概率 + 开源/闭源·强度 + 纠正入库，无多余徽章与抽屉。",
  "permissions": [
    "storage",
    "clipboardRead",
    "offscreen",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://th.629717.cc.cd/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "鹈鹕实验室 · 页面自动捕获与模型鉴定",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "clipboard-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "page-capture-frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "sandbox": {
    "pages": [
      "sandbox-preview.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; child-src 'self' * data: blob:; frame-src 'self' * data: blob:;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox-preview.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "identify-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "捕获当前页面/剪贴板 SVG 或 HTML 并打开鹈鹕鉴定窗口"
    }
  }
}
