{
  "manifest_version": 3,
  "name": "鹈鹕实验室 · 剪贴板模型鉴定助手",
  "short_name": "鹈鹕鉴定",
  "version": "1.1.0",
  "description": "自动识别剪贴板中的 SVG / HTML 代码，生成实时预览小窗口并注释模型型号与推理强度（基于 th.629717.cc.cd），支持开源/闭源药丸按钮切换过滤。",
  "permissions": [
    "storage",
    "clipboardRead",
    "offscreen",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://th.629717.cc.cd/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "鹈鹕实验室 · 剪贴板模型鉴定",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["clipboard-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "sandbox": {
    "pages": ["sandbox-preview.html"]
  },
  "web_accessible_resources": [
    {
      "resources": ["sandbox-preview.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "identify-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "读取剪贴板并打开鹈鹕预览鉴定窗口"
    }
  }
}
